{
    "manifest_version": 3,
    "name": "YSD7 Security Banner",
    "version": "1.1",
    "description": "Injects security warnings on suspicious emails and blocks suspected fake Google/Microsoft login pages.",
    "content_scripts": [
        {
            "matches": [
                "*://mail.google.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "exclude_matches": [
                "*://*.google.com/*",
                "*://*.gstatic.com/*",
                "*://*.microsoftonline.com/*",
                "*://*.microsoft.com/*",
                "*://*.live.com/*",
                "*://*.office.com/*",
                "*://*.microsoft365.com/*",
                "*://ysd7.org/*",
                "*://*.ysd7.org/*"
            ],
            "js": [
                "trusted-origins.js",
                "fake-login-detector.js"
            ],
            "run_at": "document_idle",
            "all_frames": false
        }
    ]
}
